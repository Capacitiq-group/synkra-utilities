# ===========================================================================
# CANONICAL ENVIRONMENT VARIABLES - synkra-utilities
# This service holds no shared credentials: no PocketBase URL, no Resend
# key, no Paystack key. Only its own public URL plus its own config.
# ===========================================================================

# This app's own public base URL (not shared with other apps)
SYNKRA_APP_URL=https://utilities-api.synkra.co.za

# All utilities endpoints are called cross-origin from synkra.co.za pages.
CORS_ORIGINS=https://synkra.co.za,https://www.synkra.co.za

# Temp storage - nothing here is ever persisted long-term (app/core/cleanup.py)
SYNKRA_TEMP_DIR=/tmp/synkra-utilities
SYNKRA_TEMP_TTL=600

# Size limits (MB)
SYNKRA_MAX_UPLOAD_MB=25
SYNKRA_MAX_IMAGE_MB=15
SYNKRA_MAX_CSV_MB=10

# Anonymous per-IP rate limits (slowapi)
SYNKRA_RATE_LIMIT=20/hour
SYNKRA_RATE_LIMIT_HEAVY=10/hour

# Leave false unless a LibreOffice (soffice) binary is installed on this host.
SYNKRA_ENABLE_DOCX_TO_PDF=false
